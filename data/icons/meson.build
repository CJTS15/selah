icondir = get_option('datadir') / 'icons' / 'hicolor'

install_data(
  'app-icon.svg',
  install_dir: icondir / 'scalable' / 'apps',
  rename: application_id + '.svg',
)

install_data(
  'app-icon-symbolic.svg',
  install_dir: icondir / 'symbolic' / 'apps',
  rename: application_id + '-symbolic.svg',
)
