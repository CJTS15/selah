using Gtk 4.0;
using Adw 1;
// Defined before the template so the popover's custom children find their slots.
menu primary_menu {
  section {
    item {
      custom: "theme";
    }

    item {
      custom: "zoom";
    }
  }

  section {
    item (_("_Translations…"), "win.translations")
    item (_("_Preferences"), "win.preferences")
    item (_("_Keyboard Shortcuts"), "app.shortcuts")
    item (_("_About Selah"), "win.about")
  }
}

template $SelahWindow: Adw.ApplicationWindow {
  title: _("Selah");
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      reader_header.show-back-button: false;
      show_books_button.visible: true;
      search_header.show-back-button: false;
      search_books_button.visible: true;
      saved_header.show-back-button: false;
      saved_books_button.visible: true;
      // The reader header has no room for the picker on phones.
      translation_button.visible: false;
      sidebar_translation_button.visible: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
      max-sidebar-width: 300;

      sidebar: Adw.NavigationPage {
        title: _("Books");

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            // Shown instead of the reader's picker on narrow widths.

            [start]
            MenuButton sidebar_translation_button {
              always-show-arrow: true;
              tooltip-text: _("Translation");
              visible: false;
            }

            title-widget: Adw.WindowTitle sidebar_title {
              title: _("Selah");
            };

            [end]
            MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");

              popover: PopoverMenu {
                menu-model: primary_menu;

                [theme]
                Box {
                  styles [
                    "style-switcher",
                  ]

                  spacing: 18;
                  halign: center;
                  margin-top: 6;
                  margin-bottom: 6;

                  CheckButton style_follow {
                    styles [
                      "follow",
                    ]

                    tooltip-text: _("Follow System Style");

                    accessibility {
                      label: _("Follow System Style");
                    }
                  }

                  CheckButton style_light {
                    styles [
                      "light",
                    ]

                    group: style_follow;
                    tooltip-text: _("Light Style");

                    accessibility {
                      label: _("Light Style");
                    }
                  }

                  CheckButton style_dark {
                    styles [
                      "dark",
                    ]

                    group: style_follow;
                    tooltip-text: _("Dark Style");

                    accessibility {
                      label: _("Dark Style");
                    }
                  }
                }

                [zoom]
                Box {
                  spacing: 6;
                  margin-start: 6;
                  margin-end: 6;

                  Button {
                    styles [
                      "flat",
                      "circular",
                    ]

                    icon-name: "list-remove-symbolic";
                    tooltip-text: _("Zoom Out");
                    action-name: "win.zoom-out";

                    accessibility {
                      label: _("Zoom Out");
                    }
                  }

                  Label zoom_label {
                    styles [
                      "numeric",
                    ]

                    hexpand: true;
                  }

                  Button {
                    styles [
                      "flat",
                      "circular",
                    ]

                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Zoom In");
                    action-name: "win.zoom-in";

                    accessibility {
                      label: _("Zoom In");
                    }
                  }
                }
              };
            }
          }

          // First in the sidebar once the day's verse is loaded (Preferences can hide it).

          [top]
          Button daily_card {
            visible: false;
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 6;
            action-name: "win.open-daily-verse";

            styles [
              "card",
            ]

            child: Box {
              orientation: vertical;
              spacing: 3;
              margin-top: 9;
              margin-bottom: 9;
              margin-start: 12;
              margin-end: 12;

              Label {
                label: _("Verse of the Day");
                xalign: 0;

                styles [
                  "caption-heading",
                  "dimmed",
                ]
              }

              Label daily_reference {
                xalign: 0;

                styles [
                  "heading",
                ]
              }

              Label daily_text {
                xalign: 0;
                wrap: true;
                wrap-mode: word_char;
                lines: 4;
                ellipsize: end;
              }
            };
          }

          [top]
          Adw.ToggleGroup sidebar_mode {
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 6;
            active-name: "books";

            Adw.Toggle {
              name: "books";
              label: _("Books");
            }

            Adw.Toggle {
              name: "saved";
              label: _("Saved");
            }
          }

          [top]
          SearchEntry book_filter {
            placeholder-text: _("Filter books");
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 6;
          }

          content: Stack sidebar_stack {
            StackPage {
              name: "books";

              child: ScrolledWindow book_scroller {
                hscrollbar-policy: never;

                child: ListBox book_list {
                  styles [
                    "navigation-sidebar",
                  ]

                  accessibility {
                    label: _("Books");
                  }
                };
              };
            }

            StackPage {
              name: "saved";

              child: ScrolledWindow {
                hscrollbar-policy: never;

                child: ListBox saved_filters {
                  styles [
                    "navigation-sidebar",
                  ]

                  accessibility {
                    label: _("Saved");
                  }
                };
              };
            }
          };
        };
      };

      content: Adw.NavigationPage reader_page {
        title: _("Reader");

        child: Adw.BottomSheet verse_sheet {
          show-drag-handle: true;

          content: Stack content_stack {
            StackPage {
              name: "reading";

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar reader_header {
                  // Replaces the back button on narrow widths, as in the phone mockup.

                  [start]
                  Button show_books_button {
                    visible: false;
                    icon-name: "sidebar-show-symbolic";
                    tooltip-text: _("Show Books");
                    action-name: "win.show-books";

                    accessibility {
                      label: _("Show Books");
                    }
                  }

                  [start]
                  Button {
                    icon-name: "go-previous-symbolic";
                    tooltip-text: _("Previous Chapter");
                    action-name: "win.previous-chapter";

                    accessibility {
                      label: _("Previous Chapter");
                    }
                  }

                  [start]
                  Button {
                    icon-name: "go-next-symbolic";
                    tooltip-text: _("Next Chapter");
                    action-name: "win.next-chapter";

                    accessibility {
                      label: _("Next Chapter");
                    }
                  }

                  [start]
                  ToggleButton {
                    icon-name: "user-bookmarks-symbolic";
                    tooltip-text: _("Bookmark Chapter");
                    action-name: "win.bookmark-chapter";

                    accessibility {
                      label: _("Bookmark Chapter");
                    }
                  }

                  title-widget: Adw.WindowTitle reader_title {};

                  [end]
                  Button {
                    icon-name: "system-search-symbolic";
                    tooltip-text: _("Search");
                    action-name: "win.search";

                    accessibility {
                      label: _("Search");
                    }
                  }

                  // Label and menu are set from the installed translations.

                  [end]
                  MenuButton translation_button {
                    always-show-arrow: true;
                    tooltip-text: _("Translation");
                  }
                }

                content: Stack reader_stack {
                  StackPage {
                    name: "reader";

                    child: ScrolledWindow scrolled {
                      styles [
                        "view",
                      ]

                      hscrollbar-policy: never;

                      child: Adw.ClampScrollable {
                        maximum-size: 720;

                        child: TextView text_view {
                          editable: false;
                          cursor-visible: false;
                          wrap-mode: word_char;
                          top-margin: 24;
                          bottom-margin: 48;
                          left-margin: 24;
                          right-margin: 24;
                          pixels-below-lines: 16;
                        };
                      };
                    };
                  }

                  StackPage {
                    name: "error";

                    child: Adw.StatusPage error_page {
                      icon-name: "dialog-error-symbolic";
                      title: _("Could Not Open the Bible");
                    };
                  }
                };
              };
            }

            StackPage {
              name: "search";

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar search_header {
                  // Escape closes search; on narrow widths this replaces the back button.

                  [start]
                  Button search_books_button {
                    visible: false;
                    icon-name: "sidebar-show-symbolic";
                    tooltip-text: _("Show Books");
                    action-name: "win.show-books";

                    accessibility {
                      label: _("Show Books");
                    }
                  }

                  title-widget: Adw.Clamp {
                    maximum-size: 480;
                    hexpand: true;

                    child: SearchEntry search_entry {
                      placeholder-text: _("Search or go to a reference");
                      hexpand: true;
                    };
                  };
                }

                [top]
                ScrolledWindow scope_bar {
                  vscrollbar-policy: never;
                  propagate-natural-height: true;

                  child: Adw.ToggleGroup scope_group {
                    halign: center;
                    margin-start: 12;
                    margin-end: 12;
                    margin-bottom: 6;
                    active-name: "all";

                    Adw.Toggle {
                      name: "all";
                      label: _("Whole Bible");
                    }

                    Adw.Toggle {
                      name: "ot";
                      label: _("Old Testament");
                    }

                    Adw.Toggle {
                      name: "nt";
                      label: _("New Testament");
                    }

                    Adw.Toggle book_toggle {
                      name: "book";
                    }
                  };
                }

                content: Stack search_stack {
                  StackPage {
                    name: "results";

                    child: ScrolledWindow {
                      hscrollbar-policy: never;

                      child: Adw.Clamp {
                        maximum-size: 760;

                        child: Box search_results {
                          orientation: vertical;
                          spacing: 6;
                          margin-top: 12;
                          margin-bottom: 24;
                          margin-start: 12;
                          margin-end: 12;
                        };
                      };
                    };
                  }

                  StackPage {
                    name: "empty";

                    child: Adw.StatusPage {
                      icon-name: "system-search-symbolic";
                      title: _("No Results");
                      description: _("Try other words or check the spelling");
                    };
                  }
                };
              };
            }

            StackPage {
              name: "saved";

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar saved_header {
                  [start]
                  Button saved_books_button {
                    visible: false;
                    icon-name: "sidebar-show-symbolic";
                    tooltip-text: _("Show Books");
                    action-name: "win.show-books";

                    accessibility {
                      label: _("Show Books");
                    }
                  }

                  title-widget: Adw.WindowTitle saved_title {};

                  [end]
                  DropDown saved_order {
                    tooltip-text: _("Sort Order");

                    accessibility {
                      label: _("Sort Order");
                    }
                  }
                }

                content: Stack saved_stack {
                  StackPage {
                    name: "list";

                    child: ScrolledWindow {
                      hscrollbar-policy: never;

                      child: Adw.Clamp {
                        maximum-size: 760;

                        child: Box saved_list {
                          orientation: vertical;
                          spacing: 6;
                          margin-top: 12;
                          margin-bottom: 24;
                          margin-start: 12;
                          margin-end: 12;
                        };
                      };
                    };
                  }

                  StackPage {
                    name: "empty";

                    child: Adw.StatusPage saved_empty {
                      icon-name: "user-bookmarks-symbolic";
                      title: _("Nothing Saved Yet");
                      description: _("Tap a verse to highlight or bookmark it");
                    };
                  }
                };
              };
            }
          };
        };
      };
    };
  };
}
