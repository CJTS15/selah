<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@GETTEXT_PACKAGE@">
  <schema id="@APP_ID@" path="@APP_PATH@">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="translation" type="s">
      <default>"eng-kjv"</default>
      <summary>Translation to open</summary>
      <description>The translation read last, opened again at startup. Reading positions (last-book, last-chapter) use its numbering.</description>
    </key>
    <key name="last-book" type="s">
      <default>"GEN"</default>
      <summary>Book of the last chapter read</summary>
    </key>
    <key name="last-chapter" type="u">
      <default>1</default>
      <summary>Last chapter read</summary>
    </key>
    <key name="text-scale" type="d">
      <range min="0.5" max="3.0"/>
      <default>1.0</default>
      <summary>Reader text size as a multiple of the default</summary>
    </key>
    <key name="style" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"default"</default>
      <summary>Colour style: follow the system, light or dark</summary>
    </key>
    <key name="font" type="s">
      <choices>
        <choice value="serif"/>
        <choice value="sans"/>
      </choices>
      <default>"serif"</default>
      <summary>Reading font: serif or the system sans-serif font</summary>
    </key>
    <key name="line-spacing" type="s">
      <choices>
        <choice value="comfortable"/>
        <choice value="compact"/>
        <choice value="spacious"/>
      </choices>
      <default>"comfortable"</default>
      <summary>Space between lines in the reader</summary>
    </key>
    <key name="verse-layout" type="s">
      <choices>
        <choice value="paragraphs"/>
        <choice value="lines"/>
      </choices>
      <default>"paragraphs"</default>
      <summary>Verses in paragraphs, or each verse on its own line</summary>
    </key>
    <key name="verse-numbers" type="b">
      <default>true</default>
      <summary>Show verse numbers in the reader</summary>
    </key>
    <key name="daily-verse" type="b">
      <default>true</default>
      <summary>Show the verse of the day at the top of the sidebar</summary>
    </key>
    <key name="show-deuterocanon" type="b">
      <default>true</default>
      <summary>Show the Deuterocanon in translations that include it</summary>
      <description>When off, its books are left out of the book list, navigation, reference jumps and search. Saved verses are kept.</description>
    </key>
    <key name="search-whole-words" type="b">
      <default>false</default>
      <summary>Search matches whole words only</summary>
      <description>When off, the last word typed also matches longer words that start with it.</description>
    </key>
    <key name="recent-searches" type="as">
      <default>[]</default>
      <summary>Recent searches, newest first</summary>
    </key>
  </schema>
</schemalist>
